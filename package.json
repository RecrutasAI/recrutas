{
  "name": "rest-express",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "cd client && vite --host",
    "dev:all": "npm run dev:server:start & npm run dev",
    "dev:server": "tsx watch standalone-server.js",
    "dev:server:start": "./node_modules/.bin/tsx standalone-server.js",
    "dev:server:stop": "pkill -f 'tsx standalone-server.js' || true",
    "dev:server-no-watch": "NODE_ENV=test tsx standalone-server.js",
    "build": "cd client && vite build && cd .. && npm run build:server && npm run build:api",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --outfile=dist/server/index.js --packages=external",
    "build:api": "node scripts/generate-api-handler.js",
    "postbuild": "ls -R dist",
    "start": "NODE_ENV=production node dist/index.js",
    "lint": "eslint .",
    "test": "NODE_ENV=test node run-tests.js",
    "test:unit:backend": "NODE_ENV=test node --experimental-vm-modules node_modules/jest/bin/jest --testMatch='**/test/*-unit.test.js' --forceExit",
    "test:integration:backend": "NODE_ENV=test node --experimental-vm-modules node_modules/jest/bin/jest --testMatch='**/test/*-integration.test.js'",
    "test:backend": "node --experimental-vm-modules node_modules/jest/bin/jest",
    "test:frontend": "vitest",
    "test:e2e": "node run-e2e-tests.js",
    "test:playwright": "npx playwright test",
    "test:playwright:ui": "npx playwright test --ui",
    "test:playwright:headed": "npx playwright test --headed",
    "test:google-ai": "tsx test-google-ai.ts",
    "test:resume:upload": "tsx test_resume_upload.mjs",
    "wait-for-server": "tsx scripts/wait-for-server.js",
    "test-resume-upload-direct": "tsx test_resume_upload.mjs",
    "test:all": "npm run test:unit:backend && npm run test:integration:backend && npm run test:frontend && npm run test:e2e",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest --coverage",
    "type-check": "tsc --noEmit",
    "check": "npm run type-check && npm run lint",
    "db:push": "drizzle-kit push",
    "weekly-numbers": "tsx scripts/weekly-numbers.ts"
  },
  "nodemonConfig": {
    "watch": [
      "server/"
    ],
    "ext": "ts,json",
    "exec": "tsx standalone-server.js",
    "signal": "SIGTERM",
    "delay": "2500"
  },

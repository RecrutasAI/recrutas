# Recrutas cron schedule — 1:1 port of .github/workflows/*.yml schedules.
# All times UTC (setup.sh sets the server timezone to UTC).
# Install with: crontab infra/vps/crontab
SHELL=/bin/bash
PATH=/usr/local/bin:/usr/bin:/bin
RUN=/opt/recrutas/app/infra/vps/run-cron.sh

# Enforce 24h Response SLA — hourly
0 * * * * $RUN enforce-response-sla 5 npx tsx scripts/enforce-response-sla.ts

# Scrape ATS Jobs — every 4 hours
0 */4 * * * $RUN scrape-ats-jobs 60 npx tsx scripts/scrape-all-company-jobs.ts

# Batch Embeddings (JOBS) — every 6h. The local provider (EMBED_PROVIDER=local,
# bge-small) has no quota, so cadence is driven by feed freshness rather than by
# Gemini's daily windows: at ~12.8K new jobs/day a nightly-only pass would leave
# up to 24h of supply unsearchable. ~3.2K jobs per 6h run ≈ 11 min at the measured
# ~5 jobs/sec. BATCH_LIMIT is a ceiling, not a target — it only embeds what is
# missing. On Gemini it simply early-bails once the daily cap is hit, so the value
# is safe for either provider.
#
# Hours 1/7/13/19 are deliberate, NOT `0 */6`. The per-job cgroup caps bound each
# job but NOT their SUM, so two heavy jobs overlapping can exhaust a 1.9GB box
# with swap off — and then the kernel picks the victim, which could be Postgres.
# `0 */6` put this on 06:00/18:00, exactly when scrape-tech-companies runs;
# measured 2026-07-31T18:00 with both live: 806MB + 395MB and only 280MB free,
# with the embedding pass visibly slowed by CPU contention on 2 vCPUs.
# 1/7/13/19 collide with nothing else in this file — keep it that way.
0 1,7,13,19 * * * $RUN batch-embeddings 90 env BATCH_LIMIT=20000 npx tsx server/services/batch-embedding.service.ts

# Candidate Embeddings — every 10 min, offset off the hour so it does not load a
# second copy of the ONNX model alongside the heavy top-of-hour crons (the box has
# 1.9GB and swap is disabled). Split out from the job pass because a candidate who
# just uploaded a résumé has NO embedding until this runs — their feed is
# keyword-only in the meantime — and waiting behind an hour-long job backfill would
# make that window unacceptable. Résumé upload only invalidates; this recomputes.
5-55/10 * * * * $RUN embed-candidates 10 npx tsx server/services/batch-embedding.service.ts --candidates-only

# Discover Companies — daily 02:00 (phases continue on error, like GHA)
0 2 * * * $RUN discover-companies 90 bash -c 'npx tsx scripts/discover-companies.ts --phase=discover; npx tsx scripts/discover-companies.ts --phase=apollo; npx tsx scripts/discover-companies.ts --phase=probe --limit=1500'

# Retry Failed Parses — daily 03:00
0 3 * * * $RUN retry-failed-parses 10 npx tsx scripts/retry-failed-parses.ts

# Auto-hide Ghost Jobs — daily 04:00
0 4 * * * $RUN auto-hide-ghost-jobs 5 npx tsx scripts/auto-hide-ghost-jobs.ts --staleDays=30

# Warm Candidate Matches — daily 04:30 (after ghost-job hiding)
30 4 * * * $RUN warm-candidate-matches 10 npx tsx scripts/warm-candidate-matches.ts

# Purge Old Jobs — daily 05:00
0 5 * * * $RUN purge-old-jobs 5 npx tsx scripts/purge-old-jobs.ts --retainDays=45

# Scrape External Jobs (aggregators) — daily 06:30
30 6 * * * $RUN scrape-external-jobs 12 npx tsx scripts/scrape-external-jobs.ts --timeout=540000

# Scrape Tech Companies — 06:00 and 18:00 (tiers continue on error, like GHA)
#
# Tier 3 was REMOVED 2026-08-01. It is 10 mega-corp boards (Google, Microsoft,
# Apple, Amazon, ServiceNow…) that only parse via AI, and free inference cannot
# fund them: Gemini's free tier is permanently exhausted and Groq's 100K
# tokens/day cannot cover 10 AI-parsed boards twice daily on top of tiers 1-2.
# It had failed on every run for 12+ days. Measured in isolation on 2026-08-01
# with the ENTIRE daily budget to itself, it still returned 3 jobs found / 0
# ingested / 7 errors in 8 minutes — so this was not contention with tiers 1-2.
# Against scrape-ats-jobs at ~2,700 inserted per run, tier 3 was well under 1%
# of supply for ~8 min of a 2-vCPU box twice a day, and its permanent `failed`
# state was constant noise on the alert channel that doubles as the off-box
# dead-man's switch. Revive only with paid inference (OpenRouter is already
# wired in server/lib/ai-client.ts), not by reordering the tiers.
0 6,18 * * * $RUN scrape-tech-companies 60 bash -c 'npx tsx scripts/scrape-tier.ts --tier=1 --timeout=900000; npx tsx scripts/scrape-tier.ts --tier=2 --timeout=600000; npx tsx scripts/scrape-tier.ts --cleanup --days=15'

# Cleanup Errors — weekly, Sunday 06:00
0 6 * * 0 $RUN cleanup-errors 5 npx tsx scripts/cleanup-errors.ts

# Job Supply Watchdog — daily 08:00, after the night's ingestion has landed
# (discover 02:00, tiers 06:00, aggregators 06:30). Watches OUTCOMES, not
# per-pipeline health: a ~5x supply collapse ran for weeks while every cron
# reported ok/warning, because the scrapers were healthy and simply had nothing
# new to find. Fails loudly — that is what turns into an alert email.
0 8 * * * $RUN supply-health 5 npx tsx scripts/check-supply-health.ts --minNewJobs=150 --minApproved=1

# Supabase DB backup — daily 09:00 (independent logical dump → /opt/recrutas/backups/db)
# Kept during the post-cutover rollback window: Supabase still holds auth + a
# fallback copy of the migrated data. Retire once auth also leaves Supabase.
0 9 * * * $RUN db-backup 30 bash infra/vps/backup-supabase.sh

# Self-hosted VPS DB backup — daily 09:30 (logical dump of the migrated local DB)
30 9 * * * $RUN vps-db-backup 30 bash infra/vps/backup-vps-db.sh

# Restore verification — weekly, Sunday 11:00 (after the offsite push).
# Proves the nightly dump actually restores. A backup that has never been
# restored is a hypothesis; this is the only job that turns it into a fact.
0 11 * * 0 $RUN verify-restore 60 bash infra/vps/verify-restore.sh

# Physical base backup — weekly, Sunday 08:00. The other half of PITR: WAL
# segments can only be replayed onto a PHYSICAL base backup, never onto a
# pg_dump. Also prunes archived WAL older than the oldest base backup kept.
0 8 * * 0 $RUN basebackup 60 bash infra/vps/backup-basebackup.sh

# Supabase Storage objects (résumé FILES) — daily 09:45.
# The SQL dumps only carry storage METADATA; without this the files themselves
# have no backup at all and a bucket loss is unrecoverable.
45 9 * * * $RUN storage-backup 30 bash infra/vps/backup-storage.sh

# Offsite backup push — daily 10:15 (after both dumps land; encrypts then uploads)
# Inert until OFFSITE_RCLONE_REMOTE + OFFSITE_GPG_PASSPHRASE are set in .env;
# until then it heartbeats a 'warning' so the health panel shows there is no
# offsite copy. Both dumps live on the DB's own disk, so this is the only thing
# standing between a VPS loss and total data loss.
15 10 * * * $RUN offsite-backup 45 bash infra/vps/offsite-backup.sh

# VPS DB health check — every 15 min (liveness + disk; heartbeats to pipeline_runs)
*/15 * * * * $RUN vps-db-health 3 bash infra/vps/healthcheck-db.sh
